# Copy to .env and fill in your real keys

# Firebase (required for auth + booking storage)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123:web:abc123

# Optional: Unsplash (free — 50 req/hr — register at unsplash.com/developers)
VITE_UNSPLASH_KEY=your_unsplash_access_key

# Optional: AviationStack (free tier — 100 req/mo — aviationstack.com)
VITE_AVIATION_KEY=your_aviationstack_key
