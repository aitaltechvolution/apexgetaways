# Copy to .env and fill in your values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SITE_URL=https://apexgetaways.com
VITE_CRISP_WEBSITE_ID=your-crisp-id
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# Server-side only — used by /api/flights.js, NEVER prefixed with VITE_
# (that prefix gets bundled into client JS, which would leak it to the browser).
# Get yours from https://app.duffel.com > API/Access tokens
DUFFEL_ACCESS_TOKEN=duffel_test_xxxxxxxxxxxx

# Set these in Supabase Dashboard > Edge Functions > Secrets
# RESEND_API_KEY=re_xxxxxxxxxxxx
# ADMIN_EMAIL=admin@apexgetaways.